diff --git a/src/post/dto/post-response.dto.ts b/src/post/dto/post-response.dto.ts
new file mode 100644
index 0000000..9f3fdf6
--- /dev/null
+++ b/src/post/dto/post-response.dto.ts
@@ -0,0 +1,58 @@
+import { ApiProperty } from '@nestjs/swagger';
+
+/** 작성자 정보는 id/username 만 노출 (이메일, 비밀번호 제외) */
+export class AuthorResponseDto {
+  @ApiProperty({ example: 1 })
+  id!: number;
+
+  @ApiProperty({ example: 'nickname', nullable: true, type: String })
+  username!: string | null;
+}
+
+interface PostWithAuthor {
+  id: number;
+  title: string;
+  content: string;
+  authorId: number;
+  createdAt: Date;
+  updatedAt: Date;
+  author: { id: number; username: string | null };
+}
+
+export class PostResponseDto {
+  @ApiProperty({ example: 1 })
+  id!: number;
+
+  @ApiProperty({ example: '게시글 제목' })
+  title!: string;
+
+  @ApiProperty({ example: '게시글 내용' })
+  content!: string;
+
+  @ApiProperty({ example: 1 })
+  authorId!: number;
+
+  @ApiProperty({ type: AuthorResponseDto })
+  author!: AuthorResponseDto;
+
+  @ApiProperty()
+  createdAt!: Date;
+
+  @ApiProperty()
+  updatedAt!: Date;
+
+  static from(post: PostWithAuthor): PostResponseDto {
+    const dto = new PostResponseDto();
+    dto.id = post.id;
+    dto.title = post.title;
+    dto.content = post.content;
+    dto.authorId = post.authorId;
+    dto.author = {
+      id: post.author.id,
+      username: post.author.username,
+    };
+    dto.createdAt = post.createdAt;
+    dto.updatedAt = post.updatedAt;
+    return dto;
+  }
+}
